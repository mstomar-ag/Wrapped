{
  "name": "wrapped",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render Wrapped out/wrapped.mp4",
    "build:still": "remotion still Wrapped out/frame.png",
    "server": "tsx watch server/index.ts",
    "wrap": "tsx server/cli.ts",
    "member": "tsx server/members/cli.ts",
    "github:history": "tsx scripts/github-history.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server",
    "lint:fix": "eslint src server --fix",
    "format": "prettier --write \"{src,server}/**/*.{ts,tsx}\" \"*.{ts,json,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"{src,server}/**/*.{ts,tsx}\" \"*.{ts,json,md}\" \"docs/**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@hono/node-server": "1.13.7",
    "@octokit/rest": "21.0.2",
    "@remotion/bundler": "4.0.260",
    "@remotion/cli": "4.0.260",
    "@remotion/google-fonts": "4.0.260",
    "@remotion/renderer": "4.0.260",
    "@slack/web-api": "7.8.0",
    "dotenv": "16.4.7",
    "hono": "4.6.14",
    "node-cron": "^4.2.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.260",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "19.0.0",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  }
}
