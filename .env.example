# Wrapped API server
PORT=3000

# Remotion render concurrency. Default auto-detects via os.availableParallelism()
# (respects container cgroup limits). Set explicitly to throttle on small VMs:
#   Hobby/2 vCPU  → 2
#   Pro/4 vCPU    → 3
#   Pro/8+ vCPU   → 4-6
# Each worker uses ~150 MB. See docs/railway.md.
# RENDER_CONCURRENCY=

# Slack workspace bot (xoxb-…). Scopes needed:
#   channels:history, channels:read, reactions:read, search:read, users:read,
#   users:read.email, files:write, chat:write, commands
SLACK_BOT_TOKEN=
# From the Slack app's "Basic Information" page
SLACK_SIGNING_SECRET=

# GitHub PAT with: repo (or public_repo), read:user
GITHUB_TOKEN=
# Optional: limit PR search in scripts/github-history.ts (e.g. Agrim-Intelligence)
# GITHUB_ORG=

# X (Twitter) v2 API bearer token
X_BEARER_TOKEN=

# Optional LLM providers for better copy (week title, vibe, commit summary).
# The bot tries them in this order and uses the first that works; if all fail,
# it falls back to simple heuristics.
#
#   1) Gemini (FREE tier at https://aistudio.google.com/apikey — generous limits)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
#
#   2) OpenRouter (FREE models at https://openrouter.ai/keys — picks from many)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
#   3) Anthropic Claude (paid, ~$0.001/wrap with Haiku 4.5)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Linear API key (workspace-level). Powers ticket signals for non-eng teammates.
LINEAR_API_KEY=

# Notion integration token (workspace-level). Powers page-edit signals.
NOTION_TOKEN=

# OAuth: LinkedIn (for posts) — create app at https://www.linkedin.com/developers
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# OAuth: Google (for Gmail signals) — create app at https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required if OAuth providers are configured: where the bot is publicly reachable
PUBLIC_BASE_URL=http://localhost:3000

# Required to encrypt OAuth tokens at rest. Use any 32+ char string.
ENCRYPTION_KEY=
